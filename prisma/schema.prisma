generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}
enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  DISABLED
}
enum AuditAction {
  CREATED
  APPROVED
  REJECTED
  DISABLED
  REACTIVATED
  PASSWORD_RESET
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @unique @map("user_id")
  fullName           String        @map("full_name")
  passwordHash       String        @map("password_hash")
  role               Role          @default(USER)
  status             AccountStatus @default(PENDING)
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  createdByAdminId   String?       @db.Uuid @map("created_by_admin_id")
  approvedByAdminId  String?       @db.Uuid @map("approved_by_admin_id")
  approvedAt         DateTime?     @map("approved_at")
  rejectedAt         DateTime?     @map("rejected_at")
  lastLoginAt        DateTime?     @map("last_login_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  sessions           Session[]
  settings           UserSettings?
  questions          Question[]
  auditsTarget       AccountApprovalAudit[] @relation("auditTarget")
  auditsActor        AccountApprovalAudit[] @relation("auditActor")
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid @map("user_id")
  tokenHash        String    @unique @map("session_token_hash")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  revokedAt        DateTime? @map("revoked_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("sessions")
}

model AccountApprovalAudit {
  id           String      @id @default(uuid()) @db.Uuid
  targetUserId String      @db.Uuid @map("target_user_id")
  adminUserId  String      @db.Uuid @map("admin_user_id")
  action       AuditAction
  reason       String?     @map("optional_reason")
  createdAt    DateTime    @default(now()) @map("timestamp")
  target       User        @relation("auditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  admin        User        @relation("auditActor", fields: [adminUserId], references: [id], onDelete: Restrict)
  @@index([targetUserId, createdAt])
  @@map("account_approval_audits")
}

model UserSettings {
  userId      String   @id @db.Uuid @map("user_id")
  timezone    String   @default("Asia/Kolkata")
  intervals   Int[]    @default([1, 3, 7, 15, 30, 60])
  dailyTarget Int      @default(5) @map("daily_target")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_settings")
}

model Question {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid @map("user_id")
  catalogueProblemId String? @db.Uuid @map("catalogue_problem_id")
  title          String
  category       String
  topic          String
  language       String?
  difficulty     String
  status         String
  notes          String   @default("")
  codeSnippet    String?  @map("code_snippet")
  codeLanguage   String?  @map("code_language")
  revisionStage  Int      @default(1) @map("revision_stage")
  nextDueDate    DateTime? @map("next_due_date") @db.Date
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogueProblem LeetCodeProblem? @relation(fields: [catalogueProblemId], references: [id], onDelete: SetNull)
  sources        QuestionSource[]
  revisions      RevisionHistory[]
  @@index([userId, lastActivityAt])
  @@unique([userId, catalogueProblemId])
  @@map("questions")
}

model QuestionSource {
  id                 String   @id @default(uuid()) @db.Uuid
  questionId         String   @db.Uuid @map("question_id")
  platform           String
  url                String
  platformQuestionId String?  @map("platform_question_id")
  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@map("question_sources")
}

model RevisionHistory {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid @map("question_id")
  date       DateTime @db.Date
  stage      Int
  difficulty String
  notes      String?
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@map("revision_history")
}

model LeetCodeProblem {
  id                 String   @id @default(uuid()) @db.Uuid
  frontendQuestionId String   @unique @map("frontend_question_id")
  title              String
  titleSlug          String   @map("title_slug")
  url                String
  difficulty         String
  paidOnly           Boolean  @default(false) @map("paid_only")
  category           String?
  acceptanceRate     String?  @map("acceptance_rate")
  topics             String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  trackedQuestions   Question[]
  @@map("leetcode_problems")
}
